{
  "name": "@wisp/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx/esm --watch src/server.ts",
    "build": "npm run typecheck && npm run openapi",
    "start": "node --env-file=../../.env --import tsx/esm src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi": "tsx --env-file=../../.env src/openapi.ts",
    "test": "tsx --test test/unit/*.test.ts",
    "test:db": "tsx --env-file=../../.env --test test/db/*.test.ts",
    "smoke": "tsx --env-file=../../.env scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@supabase/supabase-js": "2.115.0",
    "@wisp/shared": "workspace:*",
    "fastify": "5.12.1",
    "jose": "5.10.0",
    "pino": "9.6.0",
    "viem": "2.56.3",
    "ws": "8.21.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/ws": "^8.18.1",
    "tsx": "4.20.5",
    "typescript": "5.8.3"
  }
}
