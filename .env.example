# Wisp — local secrets (gitignored)
# Copy from .env.example if missing:  cp .env.example .env

# ── Deployer (Base Sepolia) ──────────────────────────────────────────────
# Paste your funded Sepolia deployer wallet here.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Never commit this file. Never use a mainnet key with real funds for hackathon demos.

# ── Chain ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
# Optional paid RPC if public rate-limits hit (falls back to NEXT_PUBLIC_RPC_URL):
BASE_SEPOLIA_RPC_URL=

ETHERSCAN_API_KEY=

# Manifest path (relative to repo root)
DEPLOYMENT_MANIFEST_PATH=deployments/base-sepolia.json

# Optional deterministic B20 salt namespace. Leave as v1 for the canonical deploy.
# deploy:sepolia -- --force-new generates a unique namespace when this is unset.
B20_SALT_NAMESPACE=

# Claim authorizer for escrow EIP-712 signatures.
# Must derive the claimSigner address stored in the deployment manifest.
# If unset, API/deploy fall back to DEPLOYER_PRIVATE_KEY and record that address.
CLAIM_AUTHORIZER_PRIVATE_KEY=

# ── Unused by Wisp scripts (optional forge convenience only) ─────────────
# Wisp deploy/smoke read DEPLOYER_PRIVATE_KEY only. Do not require this.
# PRIVATE_KEY=

# ── API ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
API_ORIGIN=http://127.0.0.1:8787
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
RUN_INDEXER=true

# ── Supabase server ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Optional session pooler if direct DB is IPv6-only:
# DATABASE_POOLER_URL=

# ── Supabase browser (Phase 3+) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Accepted aliases (config maps these when NEXT_PUBLIC_* unset):
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Identity and claim authorization ─────────────────────────────────────
# Generate with: openssl rand -hex 32
IDENTITY_LOOKUP_KEY=
DESCRIPTOR_SIGNING_KEY=

# ── Coinbase CDP embedded wallets (optional; report unavailable if unset) ─
# CDP Portal checklist (project must match NEXT_PUBLIC_CDP_PROJECT_ID):
# 1) Embedded Wallet → Security / Domains (Clients): allowlist every browser origin
#      http://localhost:3000
#      http://127.0.0.1:3000
#      https://wisp-base.vercel.app          (production — REQUIRED for deployed wallet create)
#      https://*-….vercel.app               (optional preview hosts if Portal supports wildcards)
#      http://192.168.x.x:3000              (only if you use the Network URL from `next dev`)
#    Portal: https://portal.cdp.coinbase.com/products/embedded-wallets/security
#    Docs:   https://docs.cdp.coinbase.com/wallets/security-and-policies/domain-allowlisting
# 2) Embedded Wallet → Auth → Custom Auth (required for Supabase):
#      JWKS:     {NEXT_PUBLIC_SUPABASE_URL}/auth/v1/.well-known/jwks.json
#      Issuer:   {NEXT_PUBLIC_SUPABASE_URL}/auth/v1
#      Audience: authenticated
#      User id claim: sub
# 3) Onchain Tools → Paymaster (required for gasless send/claim/faucet):
#      Network: Base Sepolia
#      Allowlist Wisp contracts from deployments/base-sepolia.json:
#        mockUsdc, giftEscrow, demoStockRouter, + each stock token (wAAPL/wNVDA/wTSLA)
#      App uses createOnLogin: "smart" + useCdpPaymaster: true (do NOT paste Paymaster URL in frontend)
# Prefer http://localhost:3000 locally; production must include https://wisp-base.vercel.app.
# If you previously linked an EOA-only wallet, re-verify in Account after smart accounts land.
NEXT_PUBLIC_CDP_PROJECT_ID=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# ── Web/API connection ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# Production (set by `pnpm deploy:env`, or override):
# PROD_WEB_ORIGIN=https://wisp-base.vercel.app
# PROD_API_ORIGIN=https://wisp-base-api.onrender.com
# VERCEL_SCOPE=wurli-shs-projects
# VERCEL_PROJECT=wisp-base
# RENDER_SERVICE_NAME=wisp-base-api
#
# Deploy flow:
#   pnpm deploy:env                 # sync Vercel + create/update Render
#   pnpm deploy:env -- --render-only --render-deploy
#   git push origin main            # Render auto-deploys on commit when Blueprint linked

# ── Optional notification only ───────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Demo faucet / assets (addresses come from deployments/base-sepolia.json) ─
# MockUSDC (tUSDC) is created by Wisp and minted via /faucet — not bought.
# Test stocks (wAAPL/wNVDA/wTSLA) are created via Base B20 factory and seeded
# into the demo router inventory. Users do not faucet stock tokens.
